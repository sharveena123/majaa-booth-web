# API base URL for production backend (not used when mock mode is enabled)
VITE_API_URL=https://api.example.com

# Use in-memory mock API (default: true unless explicitly set to "false")
# Seeded Snap Studio demo data (set true only for marketing demos)
VITE_USE_MOCK_API=false

# --- Firebase Authentication (client / public config from Firebase Console) ---
# Project settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated emails that receive superadmin role until you set custom claims on the server
VITE_FIREBASE_SUPERADMIN_EMAILS=admin@majaa.app

# Demo/guest shortcuts on login — default off when Firebase is configured (set true only for local dev)
VITE_ENABLE_MOCK_AUTH=false
